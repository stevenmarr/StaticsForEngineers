# StaticsForEngineers configuration. Copy to .env and fill in real values.
# NEVER commit .env. It contains your secret and the first user's password.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Default user created on FIRST start only (when the user table is empty).
DEFAULT_USER=your-username
DEFAULT_PASS=your-password

# Where the app is mounted on your site (must match the Nginx location).
BASE_PATH=/StaticsForEngineers

# Port/interface the Node app listens on.
# 0.0.0.0 lets a reverse proxy running in Docker (e.g. Caddy reaching
# host.docker.internal:3117) connect. Block port 3117 from the internet with
# your cloud firewall or ufw; only the proxy should reach it.
# If your proxy runs directly on the host (Nginx/Caddy outside Docker), 127.0.0.1 is safer.
PORT=3117
HOST=0.0.0.0

# Set to true when the site is served over HTTPS (it is on performance-video.com).
COOKIE_SECURE=true

# Which proxy addresses may set X-Forwarded-For/-Proto (needed for secure cookies
# and correct client IPs). "loopback" covers a proxy on this machine;
# 172.16.0.0/12 covers Docker's default bridge networks (172.17.x.x, 172.18.x.x, ...),
# which is where a containerized Caddy/Nginx connects from.
# Use plain "loopback" if the proxy is not in Docker.
TRUST_PROXY=loopback,172.16.0.0/12

# Folder for the SQLite database (relative to the app folder, or absolute).
DATA_DIR=data

# Time zone used for daily streaks.
APP_TZ=America/Chicago
